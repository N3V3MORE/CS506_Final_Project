import re
from functools import lru_cache
from pathlib import Path

# ========== SETTINGS ==========

INPUT_FILE = (
    Path(__file__).resolve().parent / "outputs" / "dev-other_base.en_phonemes.csv"
)


def main():
    output_file = INPUT_FILE.with_name(f"{INPUT_FILE.stem}_complete{INPUT_FILE.suffix}")
    if output_file.exists():
        raise FileExistsError(
            f"Completion output already exists: {output_file}. "
            "Move it or choose a different input before running again."
        )

    import pandas as pd
    import cmudict
    from g2p_en import G2p

    df = pd.read_csv(INPUT_FILE)

    cmu = cmudict.dict()
    g2p = G2p()

    # Valid ARPAbet phonemes
    VALID_PHONEMES = set(
        "AA AE AH AO AW AY B CH D DH EH ER EY F G HH "
        "IH IY JH K L M N NG OW OY P R S SH T TH "
        "UH UW V W Y Z ZH".split()
    )

    @lru_cache(maxsize=None)
    def pronounce_word(word):
        if word in cmu:
            phones = cmu[word][0]
            source = "cmudict"

        else:
            predicted = g2p(word)

            phones = [
                phone for phone in predicted
                if isinstance(phone, str)
                and re.sub(r"\d", "", phone) in VALID_PHONEMES
            ]

            source = "g2p" if phones else "unresolved"

        phones = [re.sub(r"\d", "", phone) for phone in phones]

        return phones, source

    def extract_phonemes(text):
        words = re.findall(r"[a-z]+(?:'[a-z]+)?", str(text).lower())

        phonemes = []
        g2p_words = []
        unresolved_words = []

        for word in words:
            phones, source = pronounce_word(word)

            phonemes.extend(phones)

            if source == "g2p":
                g2p_words.append(word)

            elif source == "unresolved":
                unresolved_words.append(word)

        return pd.Series({
            "phonemes": " ".join(phonemes),
            "num_phonemes": len(phonemes),
            "g2p_words": ", ".join(g2p_words),
            "unresolved_words": ", ".join(unresolved_words)
        })

    new_columns = df["reference_text"].apply(extract_phonemes)

    for column in new_columns.columns:
        df[column] = new_columns[column]

    # "x" fails if the output already exists.
    df.to_csv(output_file, index=False, mode="x")

    print("\n--- PHONEME COMPLETION ---")
    print("Total clips:", len(df))

    print("Clips using G2P:", (df["g2p_words"] != "").sum())
    print("Clips with unresolved words:", (df["unresolved_words"] != "").sum())

    print("\n--- G2P PRONUNCIATIONS ---")
    g2p_vocabulary = set()

    for entry in df["g2p_words"]:
        if entry:
            g2p_vocabulary.update(word.strip() for word in entry.split(","))

    for word in sorted(g2p_vocabulary):
        phones, _ = pronounce_word(word)
        print(f"{word}: {' '.join(phones)}")

    print(f"\nResults saved to {output_file}")


if __name__ == "__main__":
    main()
